# Station Manager — variáveis que este serviço lê rodando sozinho.
#
# Em produção quem manda é o .env do orquestrador (nanosat-gs/grs-station).
# Este arquivo documenta só o que ESTE repo precisa para subir isolado.

# --- Estação terrestre ---
# Lidas pela spacelab-tracking. São os DEFAULTS dos argumentos --gs-*; o valor
# abaixo é um EXEMPLO (São Paulo) e precisa ser trocado antes de qualquer uso
# real. Precisam bater com as do TC Scheduler, ou o plano e o apontamento
# divergem sobre de onde a estação observa.
GS_NAME=Estação de Teste
GS_LATITUDE_DEG=-23.5505
GS_LONGITUDE_DEG=-46.6333
GS_ALTITUDE_M=760

# --- Apontamento durante a passagem ---
# Intervalo entre atualizações. Um LEO no zênite varia ~1 grau/s, que é a
# resolução do rotor Rot2Prog (1 pulso/grau).
STATION_POINTING_INTERVAL_SECONDS=1
# Elevação mínima para comandar o rotor. Abaixo disso o satélite está do outro
# lado da Terra e o azimute varia de forma abrupta. Use -90 para exercitar o
# apontamento sem esperar uma passagem real.
STATION_POINTING_MIN_ELEVATION=0
